{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "kalama: full (CVE-2015-1427)",
            "type": "debugpy",
            "request": "launch",
            "module": "kalama.main",
            "args": ["full", "--cve", "CVE-2015-1427", "--image", "vulhub/elasticsearch:1.4.2", "--port", "9200"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/app"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "kalama: exploit (CVE-2015-1427)",
            "type": "debugpy",
            "request": "launch",
